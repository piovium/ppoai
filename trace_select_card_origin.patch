+def _should_trace_select_card_value(value: Any) -> bool:
+    if isinstance(value, bool):
+        return False
+    if isinstance(value, int):
+        return False
+    if isinstance(value, float):
+        return not value.is_integer()
+    text = repr(value)
+    return "." in text or not text.lstrip("-").isdigit()
+
+
+def _trace_select_card_candidates(*, stage: str, candidates: list[Any], extra: str = "") -> None:
+    if not any(_should_trace_select_card_value(value) for value in candidates):
+        return
+    rendered = ", ".join(
+        f"{value!r}:{type(value).__name__}"
+        for value in candidates
+    )
+    suffix = f" {extra}" if extra else ""
+    print(
+        f"[select-card-trace] stage={stage} candidates=[{rendered}]{suffix}",
+        flush=True,
+    )
+
+
