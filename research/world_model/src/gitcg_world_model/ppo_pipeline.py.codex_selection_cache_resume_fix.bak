@dataclass
class _TaggedAgent:
    inner: PolicyAgent
    trainable: bool
    tag: str

    def choose_action(self, context):
        return self.inner.choose_action(context)

    def observe_step(self, step) -> None:
        if hasattr(self.inner, "observe_step"):
            getattr(self.inner, "observe_step")(step)

    def reset_history(self) -> None:
        if hasattr(self.inner, "reset_history"):
            getattr(self.inner, "reset_history")()

    def pop_last_decision_metadata(self) -> dict[str, Any]:
        payload: dict[str, Any] = {}
        if hasattr(self.inner, "pop_last_decision_metadata"):
            payload.update(dict(getattr(self.inner, "pop_last_decision_metadata")() or {}))
        payload["ppo_trainable"] = self.trainable
        payload["policy_tag"] = self.tag
        return payload


def build_checkpoint_agent_factory(
    *,
    checkpoint_path: str | Path,
    device: str,
    sample: bool,
    temperature: float,
    player_id: int,
    trainable: bool,
    tag: str,
    opponent_tag: str,
    opponent_entity_key: str = "unknown",
    opponent_deck_name: str = "unknown",
    cache: dict[tuple[str, str], tuple[Any, Any]] | None = None,
    inference_server: GpuInferenceServer | None = None,
    env_config: EnvConfig | None = None,
) -> Callable[[int], _TaggedAgent]:
    resolved = Path(checkpoint_path)
    model, encoder = _cached_checkpoint_bundle(resolved, device=device, cache=cache)
    model_key = str(resolved.resolve())
    if inference_server is not None:
        inference_server.register_model(model_key, model)

    def factory(seed: int) -> _TaggedAgent:
        del seed
        agent = PpoAgent(
            model=model,
            encoder=encoder,
            device=device,
            sample=sample,
            temperature=temperature,
            player_id=player_id,
            opponent_tag=opponent_tag,
            opponent_entity_key=opponent_entity_key,
            opponent_deck_name=opponent_deck_name,
            inference_server=inference_server,
            model_key=model_key,
            env_config=env_config,
        )
        return _TaggedAgent(agent, trainable=trainable, tag=tag)

    return factory


def build_opponent_factory(
    kind: str,
    source: str,
    *,
    device: str,
    sample: bool = True,
    temperature: float = 1.0,
    opponent_entity_key: str = "unknown",
    opponent_deck_name: str = "unknown",
    observed_opponent_tag: str = "unknown",
    cache: dict[tuple[str, str], tuple[Any, Any]] | None = None,
    inference_server: GpuInferenceServer | None = None,
    env_config: EnvConfig | None = None,
) -> Callable[[int], _TaggedAgent]:
    if kind in {"main", "current", "best_response", "br", "frozen_population"}:
        return build_checkpoint_agent_factory(
            checkpoint_path=source,
            device=device,
            sample=sample,
            temperature=temperature,
            player_id=1,
            trainable=False,
            tag=f"{kind}:{Path(source).name}",
            opponent_tag=observed_opponent_tag,
            opponent_entity_key=opponent_entity_key,
            opponent_deck_name=opponent_deck_name,
            cache=cache,
            inference_server=inference_server,
            env_config=env_config,
        )
    normalized = source.strip().lower()
    if normalized in {"baseline_heuristic", "heuristic"}:
        return lambda seed: _TaggedAgent(HeuristicAgent(), trainable=False, tag="baseline:heuristic")
    if normalized in {"baseline_scripted", "scripted"}:
        return lambda seed: _TaggedAgent(ScriptedBootstrapAgent(), trainable=False, tag="baseline:scripted")
    return lambda seed: _TaggedAgent(LegalRandomAgent(seed=seed), trainable=False, tag="baseline:random")


def build_meta_mixture_factory(
    *,
    frozen_population: Sequence[PolicyEntry],
    meta_strategy: MetaStrategySnapshot,
    device: str,
    player_id: int,
    trainable: bool,
    tag: str,
    opponent_entity_key: str,
    opponent_deck_name: str,
    sample: bool,
    temperature: float,
    cache: dict[tuple[str, str], tuple[Any, Any]] | None = None,
    inference_server: GpuInferenceServer | None = None,
    env_config: EnvConfig | None = None,
) -> Callable[[int], _TaggedAgent]:
    entries = tuple(frozen_population)
    weighted_builders: list[tuple[float, str, Callable[[int], PolicyAgent]]] = []
    for entry in entries:
        checkpoint_factory = build_checkpoint_agent_factory(
            checkpoint_path=entry.checkpoint_path,
            device=device,
            sample=sample,
            temperature=temperature,
            player_id=player_id,
            trainable=False,
            tag=f"meta:{entry.policy_id}",
            opponent_tag="unknown",
            opponent_entity_key=opponent_entity_key,
            opponent_deck_name=opponent_deck_name,
            cache=cache,
            inference_server=inference_server,
            env_config=env_config,
        )
        weighted_builders.append(
            (
                float(meta_strategy.probabilities.get(entry.policy_id, 0.0)),
                entry.policy_id,
                lambda seed, factory=checkpoint_factory: factory(seed).inner,
            )
        )

    def factory(seed: int) -> _TaggedAgent:
        agent = MetaMixtureAgent(seed=seed, weighted_builders=tuple(weighted_builders))
        return _TaggedAgent(agent, trainable=trainable, tag=tag)

    return factory


def _cached_checkpoint_bundle(
    checkpoint_path: Path,
    *,
    device: str,
    cache: dict[tuple[str, str], tuple[Any, Any]] | None = None,
) -> tuple[Any, Any]:
    key = (str(checkpoint_path.resolve()), device)
    if cache is not None and key in cache:
        return cache[key]
    try:
        model, encoder, _ = load_ppo_deployment_checkpoint(checkpoint_path, device=device)
    except Exception:
        model, encoder, _, _ = load_ppo_training_checkpoint(checkpoint_path, device=device)
    if cache is not None:
        cache[key] = (model, encoder)
    return model, encoder


def _opponent_tag(kind: str, source: str) -> str:
    return opponent_tag(kind, source)


def _run_episode(
    *,
    config: EnvConfig,
    matchup: Matchup,
    agent0: _TaggedAgent,
    agent1: _TaggedAgent,
    seed: int,
    max_decisions: int | None,
) -> EpisodeRecord:
    agent0.reset_history()
    agent1.reset_history()
    return run_event_episode(
        config=config,
        matchup=matchup,
        agent0=agent0,
        agent1=agent1,
        seed=seed,
        max_decisions=max_decisions,
    )


_EPISODE_RETRY_LIMIT_ENV = "GITCG_EPISODE_RETRY_LIMIT"
_EPISODE_RETRY_LIMIT_DEFAULT = 8
_EPISODE_RETRY_SEED_STRIDE = 1_000_003


def _episode_retry_limit() -> int:
    raw = os.environ.get(_EPISODE_RETRY_LIMIT_ENV)
    if raw is None:
        return _EPISODE_RETRY_LIMIT_DEFAULT
    try:
        return max(0, int(raw.strip()))
    except ValueError:
        return _EPISODE_RETRY_LIMIT_DEFAULT


def _all_player_characters_defeated(player: Any) -> bool:
    characters = tuple(getattr(player, "characters", ()) or ())
    return bool(characters) and all(bool(getattr(character, "defeated", False)) for character in characters)


def _episode_retry_reason(*, episode: EpisodeRecord, config: EnvConfig) -> str | None:
    metadata = dict(episode.metadata or {})
    if bool(metadata.get("invalid_terminal")):
        return str(metadata.get("invalid_terminal_reason") or "invalid_terminal")
    if bool(metadata.get("truncated")):
        return str(metadata.get("truncation_reason") or "truncated_episode")

    final_state = episode.final_state
    phase = str(getattr(final_state, "phase", "") or "")
    if phase != "game_end":
        return f"terminal_phase={phase or 'unknown'}"

    players = tuple(getattr(final_state, "players", ()) or ())
    if len(players) != 2:
        return None

    player0_all_defeated = _all_player_characters_defeated(players[0])
    player1_all_defeated = _all_player_characters_defeated(players[1])
    winner = episode.winner

    if winner == 0:
        if player1_all_defeated and not player0_all_defeated:
            return None
        return "inconsistent_final_winner=0"
    if winner == 1:
        if player0_all_defeated and not player1_all_defeated:
            return None
        return "inconsistent_final_winner=1"

    final_round = int(getattr(final_state, "round_number", 0) or 0)
    max_rounds = (
        int(config.max_rounds)
        if getattr(config, "max_rounds", None) is not None
        else None
    )
    if player0_all_defeated and player1_all_defeated:
        return None
    if max_rounds is not None and final_round >= max_rounds:
        return None
    return "invalid_draw_without_dual_ko_or_round_cap"


def _benchmark_eval_workers(requested_workers: int) -> int:
    requested = max(1, int(requested_workers))
    raw_override = os.environ.get(_BENCHMARK_WORKERS_ENV)
    if raw_override is not None:
        try:
            override = max(1, int(raw_override.strip()))
        except ValueError:
            override = _DEFAULT_BENCHMARK_WORKER_CAP
        return min(requested, override)
    # Selection / payoff evaluation previously forced single-worker execution to
    # avoid JS heap OOMs. Keep the cap conservative, but allow a small amount of
    # parallelism now that benchmark caches are compact.
    return min(requested, _DEFAULT_BENCHMARK_WORKER_CAP)


def _benchmark_eval_flush_threshold(total_jobs: int) -> int:
    total = max(1, int(total_jobs))
    raw_override = os.environ.get(_BENCHMARK_CACHE_FLUSH_ENV)
    if raw_override is not None:
        try:
            override = max(1, int(raw_override.strip()))
        except ValueError:
            override = _DEFAULT_BENCHMARK_CACHE_FLUSH
        return min(total, override)
    return min(total, _DEFAULT_BENCHMARK_CACHE_FLUSH)


def _cached_benchmark_final_state(winner: int | None) -> StateSnapshot:
    return StateSnapshot(
        phase="benchmark_cache",
        round_number=0,
        current_turn=-1,
        winner=winner,
        players=(_EMPTY_CACHE_PLAYER, _EMPTY_CACHE_PLAYER),
    )


def _serialize_benchmark_cache_episode(episode: EpisodeRecord) -> dict[str, Any]:
    return {
        "_wm_cache_format": _BENCHMARK_CACHE_FORMAT,
        "matchup": episode.matchup,
        "seed": episode.seed,
        "winner": episode.winner,
        "step_count": len(episode.steps),
        "metadata": dict(episode.metadata),
    }


def _deserialize_benchmark_cache_episode(payload: dict[str, Any]) -> EpisodeRecord:
    winner = payload.get("winner")
    return EpisodeRecord(
        matchup=str(payload["matchup"]),
        seed=payload.get("seed"),
        winner=winner,
        steps=(),
        final_state=_cached_benchmark_final_state(winner if winner in {0, 1} else None),
        final_state_json=None,
        metadata=dict(payload.get("metadata", {})),
    )


def _append_benchmark_cache_episodes(path: Path, episodes: Sequence[EpisodeRecord]) -> None:
    destination = Path(path)
    destination.parent.mkdir(parents=True, exist_ok=True)
    with destination.open("a", encoding="utf-8") as handle:
        for episode in episodes:
            handle.write(json.dumps(_serialize_benchmark_cache_episode(episode), sort_keys=True))
            handle.write("\n")


def _load_benchmark_cache_episodes(path: Path) -> list[EpisodeRecord]:
    source = Path(path)
    cached: list[EpisodeRecord] = []
    for payload in iter_episode_record_payloads(source):
        if payload.get("_wm_cache_format") != _BENCHMARK_CACHE_FORMAT:
            return load_episode_records(source)
        cached.append(_deserialize_benchmark_cache_episode(payload))
    return cached


def _run_episode_job(
    *,
    config: EnvConfig,
    max_decisions: int | None,
    job: _EpisodeJob,
) -> _EpisodeJobResult:
    requested_seed = int(job.seed)
    retry_limit = _episode_retry_limit()
    for attempt in range(retry_limit + 1):
        effective_seed = requested_seed + (attempt * _EPISODE_RETRY_SEED_STRIDE)
        try:
            episode = _run_episode(
                config=config,
                matchup=job.matchup,
                agent0=job.agent0_factory(effective_seed),
                agent1=job.agent1_factory(effective_seed + 17),
                seed=effective_seed,
                max_decisions=max_decisions,
            )
        except Exception as exc:
            if attempt >= retry_limit:
                raise
            print(
                "[episode-error] "
                f"matchup={job.matchup.key} seed={requested_seed} actual_seed={effective_seed} "
                f"attempt={attempt + 1}/{retry_limit} "
                f"error={type(exc).__name__}: {exc}\n"
                f"{traceback.format_exc()}",
                flush=True,
            )
            print(
                "[episode-retry] "
                f"matchup={job.matchup.key} seed={requested_seed} actual_seed={effective_seed} "
                f"attempt={attempt + 1}/{retry_limit} reason=exception:{type(exc).__name__}",
                flush=True,
            )
            gc.collect()
            time.sleep(0.25)
            continue

        merged_metadata = {**episode.metadata, **job.metadata} if job.metadata else dict(episode.metadata)
        retry_reason = _episode_retry_reason(
            episode=replace(episode, metadata=merged_metadata),
            config=config,
        )
        if retry_reason is None:
            if attempt > 0:
                merged_metadata.update(
                    {
                        "requested_seed": requested_seed,
                        "actual_seed": effective_seed,
                        "retry_attempt": attempt,
                        "resampled_episode": True,
                    }
                )
            episode = replace(
                episode,
                seed=requested_seed,
                metadata=merged_metadata,
            )
            return _EpisodeJobResult(job=job, episode=episode)

        if attempt >= retry_limit:
            merged_metadata.update(
                {
                    "requested_seed": requested_seed,
                    "actual_seed": effective_seed,
                    "retry_attempt": attempt,
                    "retry_exhausted": True,
                    "retry_reason": retry_reason,
                }
            )
            episode = replace(
                episode,
                seed=requested_seed,
                metadata=merged_metadata,
            )
            return _EpisodeJobResult(job=job, episode=episode)

        print(
            "[episode-retry] "
            f"matchup={job.matchup.key} seed={requested_seed} actual_seed={effective_seed} "
            f"attempt={attempt + 1}/{retry_limit} reason={retry_reason}",
            flush=True,
        )
        gc.collect()

    raise RuntimeError("episode retry loop exited unexpectedly")

def _execute_episode_jobs(
    *,
    config: EnvConfig,
    jobs: Sequence[_EpisodeJob],
    max_decisions: int | None,
    workers: int,
    output_path: str | Path | None = None,
    progress_callback: Callable[[int, int, _EpisodeJobResult], None] | None = None,
    flush_threshold: int = 8,
    load_persisted_episodes: Callable[[Path], list[EpisodeRecord]] | None = None,
    persist_episodes: Callable[[Path, Sequence[EpisodeRecord]], None] | None = None,
) -> tuple[EpisodeRecord, ...]:
    destination = Path(output_path) if output_path is not None else None
    total = len(jobs)
    completed: list[_EpisodeJobResult] = []
    effective_workers = max(1, workers)
    pending_episodes: list[EpisodeRecord] = []
    flush_threshold = max(1, int(flush_threshold))
    episode_loader = load_persisted_episodes or load_episode_records
    episode_persister = persist_episodes or append_episode_records

    def episode_key(*, matchup: str, seed: int | None) -> tuple[str, int | None]:
        return (matchup, seed)

    existing_by_key: dict[tuple[str, int | None], EpisodeRecord] = {}
    if destination is not None and destination.exists():
        for episode in episode_loader(destination):
            existing_by_key.setdefault(
                episode_key(matchup=episode.matchup, seed=episode.seed),
                episode,
            )

    remaining_jobs: list[_EpisodeJob] = []
    for job in jobs:
        key = episode_key(matchup=job.matchup.key, seed=job.seed)
        existing_episode = existing_by_key.get(key)
        if existing_episode is None:
            remaining_jobs.append(job)
            continue
        completed.append(_EpisodeJobResult(job=job, episode=existing_episode))

    def flush_pending() -> None:
        nonlocal pending_episodes
        if destination is None or not pending_episodes:
            pending_episodes = []
            return
        episode_persister(destination, pending_episodes)
        pending_episodes = []
        gc.collect()

    completed.sort(key=lambda item: item.job.job_index)
    if progress_callback is not None:
        for index, result in enumerate(completed, start=1):
            progress_callback(index, total, result)

    done_offset = len(completed)
    if not remaining_jobs:
        return tuple(item.episode for item in completed)

    if effective_workers <= 1:
        for index, job in enumerate(remaining_jobs, start=1):
            result = _run_episode_job(config=config, max_decisions=max_decisions, job=job)
            completed.append(result)
            pending_episodes.append(result.episode)
            if len(pending_episodes) >= flush_threshold:
                flush_pending()
            if progress_callback is not None:
                progress_callback(done_offset + index, total, result)
    else:
        with ThreadPoolExecutor(max_workers=effective_workers) as executor:
            futures = [
                executor.submit(
                    _run_episode_job,
                    config=config,
                    max_decisions=max_decisions,
                    job=job,
                )
                for job in remaining_jobs
            ]
            done = done_offset
            for future in as_completed(futures):
                result = future.result()
                completed.append(result)
                done += 1
                pending_episodes.append(result.episode)
                if len(pending_episodes) >= flush_threshold:
                    flush_pending()
                if progress_callback is not None:
                    progress_callback(done, total, result)
    flush_pending()
    completed.sort(key=lambda item: item.job.job_index)
    return tuple(item.episode for item in completed)


def _throughput_details(
    *,
    started_at: float,
    completed_episodes: int,
    total_steps: int,
    inference_server: GpuInferenceServer | None,
) -> dict[str, float]:
    elapsed = max(1e-6, time.perf_counter() - started_at)
    stats = inference_server.stats() if inference_server is not None else {}
    return {
        "episodes_per_min": (completed_episodes / elapsed) * 60.0,
        "decisions_per_second": total_steps / elapsed,
        "avg_inference_batch_size": float(stats.get("avg_batch_size", 1.0 if completed_episodes else 0.0)),
    }


def _resolve_initial_checkpoint(
    init_checkpoint: str | Path | None,
    state: _LoopState,
) -> Path | None:
    if state.working_checkpoint is not None:
        resolved = _deployment_from_training_checkpoint(state.working_checkpoint)
        return resolved if resolved.exists() else state.working_checkpoint
    if init_checkpoint is None:
        return None
    candidate = Path(init_checkpoint)
    if not candidate.exists():
        return None
    resolved = _deployment_from_training_checkpoint(candidate)
    return resolved if resolved.exists() else candidate


def _round_base_checkpoint(
    *,
    round_dir: Path,
    fallback: Path | None,
) -> Path | None:
    train_artifacts = load_ppo_train_artifacts(round_dir / "train")
    if train_artifacts is not None:
        return Path(train_artifacts.deployment_checkpoint)
    bootstrap_artifacts = load_ppo_train_artifacts(round_dir / "bootstrap_train")
    if bootstrap_artifacts is not None:
        return Path(bootstrap_artifacts.deployment_checkpoint)
    return fallback


def _deployment_from_training_checkpoint(training_checkpoint: str | Path) -> Path:
    candidate = Path(training_checkpoint)
    sibling = candidate.with_name("deployment.pt")
    return sibling if sibling.exists() else candidate


def _candidate_checkpoint_path(train_dir: Path, epoch: int) -> Path:
    return train_dir / "candidates" / f"epoch_{epoch:03d}.pt"


def _load_training_summary_payload(summary_path: str | Path) -> dict[str, Any]:
    return json.loads(Path(summary_path).read_text(encoding="utf-8"))


def _candidate_epochs_from_summary(summary_payload: dict[str, Any]) -> list[int]:
    epochs = [int(item) for item in summary_payload.get("candidate_epochs", [])]
    if epochs:
        return epochs
    history = list(summary_payload.get("history", []))
    return list(range(1, len(history) + 1))


def _safe_candidate_epochs(summary_payload: dict[str, Any], *, max_safe_kl: float) -> list[int]:
    safe_epochs: list[int] = []
    history = list(summary_payload.get("history", []))
    for epoch in _candidate_epochs_from_summary(summary_payload):
        if epoch <= 0 or epoch > len(history):
            continue
        metrics = dict(history[epoch - 1])
        if not all(math.isfinite(float(value)) for value in metrics.values()):
            continue
        if float(metrics.get("approx_kl", float("inf"))) <= max_safe_kl:
            safe_epochs.append(epoch)
    return safe_epochs


def _shortlist_candidate_epochs(
    summary_payload: dict[str, Any],
    *,
    max_safe_kl: float,
    shortlist_size: int,
) -> tuple[list[int], list[int], str | None]:
    history = list(summary_payload.get("history", []))
    safe_epochs = _safe_candidate_epochs(summary_payload, max_safe_kl=max_safe_kl)
    fallback_reason: str | None = None
    if safe_epochs:
        ranked = [
            safe_epochs[-1],
            min(safe_epochs, key=lambda epoch: float(history[epoch - 1]["total_loss"])),
            min(safe_epochs, key=lambda epoch: float(history[epoch - 1]["value_loss"])),
        ]
    else:
        candidate_epochs = _candidate_epochs_from_summary(summary_payload)
        if not candidate_epochs:
            return [], [], "no_candidate_epochs"
        ranked = [min(candidate_epochs, key=lambda epoch: float(history[epoch - 1]["approx_kl"]))]
        fallback_reason = "no_safe_epoch"
    shortlist: list[int] = []
    for epoch in ranked:
        if epoch not in shortlist:
            shortlist.append(epoch)
        if len(shortlist) >= shortlist_size:
            break
    return shortlist, safe_epochs, fallback_reason


def _population_entity_id(*, kind: str, source: str) -> str:
    return shared_population_entity_id(kind=kind, source=source)

def _load_loop_state(path: Path) -> _LoopState:
    if not path.exists():
        return _LoopState(
            working_checkpoint=None,
            completed_round=0,
        )
    payload = json.loads(path.read_text(encoding="utf-8"))
    working = Path(payload["working_checkpoint"]) if payload.get("working_checkpoint") else None
    return _LoopState(
        working_checkpoint=working if working is not None and working.exists() else None,
        completed_round=int(payload.get("round", 0)),
        current_round=(
            int(payload["current_round"])
            if payload.get("current_round") is not None
            else None
        ),
        current_phase=(
            str(payload["current_phase"])
            if payload.get("current_phase") is not None
            else None
        ),
    )


def _save_loop_state(
    path: Path,
    *,
    working_checkpoint: Path | None,
    completed_round: int,
    current_round: int | None = None,
    current_phase: str | None = None,
    p2sro_state_path: Path | None = None,
    meta_strategy_path: Path | None = None,
) -> None:
    atomic_write_json(
        path,
        {
            "working_checkpoint": str(working_checkpoint) if working_checkpoint is not None else None,
            "round": completed_round,
            "current_round": current_round,
            "current_phase": current_phase,
            "p2sro_state_path": str(p2sro_state_path) if p2sro_state_path is not None else None,
            "meta_strategy_path": str(meta_strategy_path) if meta_strategy_path is not None else None,
        },
    )


def _load_completed_slot_artifacts(
    train_dir: Path,
) -> tuple[Path, int, Path, _SlotCandidateEvaluation] | None:
    train_artifacts = load_ppo_train_artifacts(train_dir)
    selection_summary_path = train_dir / "selection_summary.json"
    if train_artifacts is None or not selection_summary_path.exists():
        return None
    payload = json.loads(selection_summary_path.read_text(encoding="utf-8"))
    selected_epoch = int(payload.get("selected_epoch", 0))
    selected_checkpoint = Path(payload.get("selected_checkpoint", train_artifacts.deployment_checkpoint))
    if not selected_checkpoint.exists():
        return None
    selected_candidate_payload: dict[str, Any] | None = None
    for candidate_payload in payload.get("candidates", []):
        if int(candidate_payload.get("epoch", -1)) == selected_epoch:
            selected_candidate_payload = dict(candidate_payload)
            break
    candidate = _SlotCandidateEvaluation(
        epoch=selected_epoch,
        checkpoint_path=str(selected_checkpoint),
        expected_payoff_vs_meta=float(payload.get("expected_payoff_vs_meta", 0.0)),
        matchup_results=tuple(
            dict(item) for item in (selected_candidate_payload or {}).get("matchup_results", [])
        ),
        per_policy_payoffs=dict((selected_candidate_payload or {}).get("per_policy_payoffs", {})),
        meta_policy_probabilities={
            str(key): float(value)
            for key, value in dict(payload.get("meta_policy_probabilities", {})).items()
        },
    )
    return selected_checkpoint, selected_epoch, selection_summary_path, candidate



def _load_partial_slot_train_artifacts(train_dir: Path) -> PpoTrainArtifacts | None:
    return load_ppo_train_artifacts(train_dir)


def _infer_resume_cursor(
    workspace_path: Path,
    *,
    rounds: int,
    initial_checkpoint: Path | None,
    completed_round: int,
) -> _ResumeCursor | None:
    for round_index in range(max(1, completed_round + 1), rounds + 1):
        round_dir = workspace_path / f"round_{round_index:04d}"
        if not round_dir.exists():
            phase = "bootstrap" if round_index == 1 and initial_checkpoint is None else "active_main_slot"
            return _ResumeCursor(round_index=round_index, phase=phase)
        base_checkpoint = _round_base_checkpoint(
            round_dir=round_dir,
            fallback=initial_checkpoint,
        )
        if base_checkpoint is None:
            return _ResumeCursor(round_index=round_index, phase="bootstrap")
        if not (round_dir / "self_play.jsonl").exists() or _load_completed_slot_artifacts(round_dir / "train") is None:
            return _ResumeCursor(round_index=round_index, phase="active_main_slot")
        if not (round_dir / "br_self_play.jsonl").exists() or _load_completed_slot_artifacts(round_dir / "br_train") is None:
            return _ResumeCursor(round_index=round_index, phase="active_br_slot")
        if not (round_dir / "analysis.json").exists():
            return _ResumeCursor(round_index=round_index, phase="round_finalize")
    return None


def _prepare_round_for_resume(workspace_path: Path, round_index: int, phase: str) -> None:
    round_dir = workspace_path / f"round_{round_index:04d}"
    if not round_dir.exists():
        return
    cleanup_by_phase: dict[str, tuple[str, ...]] = {
        "bootstrap": (
            "bootstrap_train",
            "self_play.jsonl",
            "self_play_analysis.json",
            "train",
            "br_self_play.jsonl",
            "br_self_play_analysis.json",
            "br_train",
            "analysis.json",
        ),
        "active_main_slot": (
            "self_play_analysis.json",
            "br_self_play.jsonl",
            "br_self_play_analysis.json",
            "br_train",
            "analysis.json",
        ),
        "active_br_slot": (
            "br_self_play_analysis.json",
            "analysis.json",
        ),
        "round_finalize": (
            "analysis.json",
        ),
    }
    for relative_path in cleanup_by_phase.get(phase, ()):
        target = round_dir / relative_path
        if target.is_dir():
            shutil.rmtree(target, ignore_errors=True)
        elif target.exists():
            target.unlink()


def _load_completed_round_results(workspace_path: Path) -> list[PpoManagedRoundResult]:
    results: list[PpoManagedRoundResult] = []
    for round_dir in sorted(workspace_path.glob("round_*")):
        if not round_dir.is_dir():
            continue
        train_artifacts = load_ppo_train_artifacts(round_dir / "train")
        analysis_path = round_dir / "analysis.json"
        bootstrap_episodes: tuple[EpisodeRecord, ...] = ()
        self_play_episodes: tuple[EpisodeRecord, ...] = ()
        replay_episodes: tuple[EpisodeRecord, ...] = ()
        br_self_play_episodes: tuple[EpisodeRecord, ...] = ()
        br_replay_episodes: tuple[EpisodeRecord, ...] = ()
        self_play_path = round_dir / "self_play.jsonl"
        if train_artifacts is None or not analysis_path.exists() or not self_play_path.exists():
            continue
        try:
            round_index = int(round_dir.name.split("_", maxsplit=1)[1])
        except (IndexError, ValueError):
            continue
        analysis_payload = json.loads(analysis_path.read_text(encoding="utf-8"))
        results.append(
            PpoManagedRoundResult(
                round_index=round_index,
                bootstrap_path=analysis_payload.get("bootstrap_path"),
                self_play_path=str(self_play_path),
                train_artifacts=train_artifacts,
                analysis_path=str(analysis_path),
                working_checkpoint=train_artifacts.deployment_checkpoint,
                deployment_checkpoint=train_artifacts.deployment_checkpoint,
            )
        )
    return results




_REPLAY_MEMORY_CHECK_INTERVAL = 64
_REPLAY_DEFAULT_MAX_PER_FILE = 768
_REPLAY_DEFAULT_MAX_TOTAL = 2048
_REPLAY_ENV_MAX_PER_FILE = "GITCG_REPLAY_MAX_PER_FILE"
_REPLAY_ENV_MAX_TOTAL = "GITCG_REPLAY_MAX_TOTAL"


def _env_int(name: str) -> int | None:
    raw = os.environ.get(name)
    if raw is None:
        return None
    text = raw.strip()
    if not text:
        return None
    try:
        return int(text)
    except ValueError:
        return None


def _process_rss_bytes() -> int | None:
    if os.name == "nt":
        class PROCESS_MEMORY_COUNTERS(ctypes.Structure):
            _fields_ = [
                ("cb", ctypes.c_ulong),
                ("PageFaultCount", ctypes.c_ulong),
                ("PeakWorkingSetSize", ctypes.c_size_t),
                ("WorkingSetSize", ctypes.c_size_t),
                ("QuotaPeakPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPagedPoolUsage", ctypes.c_size_t),
                ("QuotaPeakNonPagedPoolUsage", ctypes.c_size_t),
                ("QuotaNonPagedPoolUsage", ctypes.c_size_t),
                ("PagefileUsage", ctypes.c_size_t),
                ("PeakPagefileUsage", ctypes.c_size_t),
            ]

        counters = PROCESS_MEMORY_COUNTERS()
        counters.cb = ctypes.sizeof(PROCESS_MEMORY_COUNTERS)
        kernel32 = ctypes.windll.kernel32
        psapi = ctypes.windll.psapi
        process_handle = kernel32.GetCurrentProcess()
        ok = psapi.GetProcessMemoryInfo(
            process_handle,
            ctypes.byref(counters),
            counters.cb,
        )
        if not ok:
            return None
        return int(counters.WorkingSetSize)

    try:
        statm_path = Path("/proc/self/statm")
        if statm_path.exists():
            fields = statm_path.read_text(encoding="utf-8").split()
            if len(fields) >= 2:
                page_size = os.sysconf("SC_PAGE_SIZE")
                return int(fields[1]) * int(page_size)
    except Exception:
        pass
    return None


def _available_memory_bytes() -> int | None:
    if os.name == "nt":
        class MEMORYSTATUSEX(ctypes.Structure):
            _fields_ = [
                ("dwLength", ctypes.c_ulong),
                ("dwMemoryLoad", ctypes.c_ulong),
                ("ullTotalPhys", ctypes.c_ulonglong),
                ("ullAvailPhys", ctypes.c_ulonglong),
                ("ullTotalPageFile", ctypes.c_ulonglong),
                ("ullAvailPageFile", ctypes.c_ulonglong),
                ("ullTotalVirtual", ctypes.c_ulonglong),
                ("ullAvailVirtual", ctypes.c_ulonglong),
                ("ullAvailExtendedVirtual", ctypes.c_ulonglong),
            ]

        status = MEMORYSTATUSEX()
        status.dwLength = ctypes.sizeof(MEMORYSTATUSEX)
        ok = ctypes.windll.kernel32.GlobalMemoryStatusEx(ctypes.byref(status))
        if not ok:
            return None
        return int(status.ullAvailPhys)

    meminfo_path = Path("/proc/meminfo")
    if meminfo_path.exists():
        try:
            for line in meminfo_path.read_text(encoding="utf-8").splitlines():
                if line.startswith("MemAvailable:"):
                    parts = line.split()
                    if len(parts) >= 2:
                        return int(parts[1]) * 1024
        except Exception:
            pass
    try:
        page_size = int(os.sysconf("SC_PAGE_SIZE"))
        available_pages = int(os.sysconf("SC_AVPHYS_PAGES"))
        return page_size * available_pages
    except (ValueError, OSError, AttributeError):
        return None


def _select_replay_load_limits() -> tuple[int, int]:
    override_per_file = _env_int(_REPLAY_ENV_MAX_PER_FILE)
    override_total = _env_int(_REPLAY_ENV_MAX_TOTAL)
    if override_per_file is not None or override_total is not None:
        max_per_file = max(
            0,
            override_per_file if override_per_file is not None else _REPLAY_DEFAULT_MAX_PER_FILE,
        )
        max_total = max(
            0,
            override_total if override_total is not None else _REPLAY_DEFAULT_MAX_TOTAL,
        )
        return max_per_file, max_total

    gib = 1024 ** 3
    rss = _process_rss_bytes()
    available = _available_memory_bytes()

    if available is not None and available < (2 * gib):
        return 64, 256
    if rss is not None and rss >= (28 * gib):
        return 64, 256
    if available is not None and available < (4 * gib):
        return 128, 512
    if rss is not None and rss >= (24 * gib):
        return 128, 512
    if available is not None and available < (8 * gib):
        return 256, 1024
    if rss is not None and rss >= (20 * gib):
        return 256, 1024
    if available is not None and available < (12 * gib):
        return 512, 1536
    if rss is not None and rss >= (16 * gib):
        return 512, 1536
    return _REPLAY_DEFAULT_MAX_PER_FILE, _REPLAY_DEFAULT_MAX_TOTAL


def _replay_memory_pressure_hard() -> bool:
    gib = 1024 ** 3
    rss = _process_rss_bytes()
    available = _available_memory_bytes()
    if available is not None and available < int(1.5 * gib):
        return True
    if rss is not None and rss >= (29 * gib):
        return True
    return False


def _collect_recent_replay_paths(
    workspace_path: Path,
    *,
    current_round: int,
    replay_round_window: int,
    include_br: bool,
) -> list[Path]:
    paths: list[Path] = []
    round_start = max(1, current_round - replay_round_window)
    for round_index in range(current_round - 1, round_start - 1, -1):
        round_dir = workspace_path / f"round_{round_index:04d}"
        primary_path = round_dir / "self_play.jsonl"
        if primary_path.exists():
            paths.append(primary_path)
        if include_br:
            br_path = round_dir / "br_self_play.jsonl"
            if br_path.exists():
                paths.append(br_path)
    return paths


def _load_replay_episodes_with_budget(
    paths: Sequence[Path],
    *,
    label: str,
) -> tuple[EpisodeRecord, ...]:
    if not paths:
        return ()

    gc.collect()
    max_per_file, max_total = _select_replay_load_limits()
    if max_per_file <= 0 or max_total <= 0:
        return ()

    replay_episodes: list[EpisodeRecord] = []
    stop_reason: str | None = None
    loaded_paths = 0

    for path in paths:
        remaining_total = max_total - len(replay_episodes)
        if remaining_total <= 0:
            stop_reason = "total_budget"
            break

        dynamic_per_file, dynamic_total = _select_replay_load_limits()
        remaining_dynamic_total = max(0, dynamic_total - len(replay_episodes))
        effective_per_file = min(
            max_per_file,
            dynamic_per_file,
            remaining_total,
            remaining_dynamic_total,
        )
        if effective_per_file <= 0:
            stop_reason = "dynamic_budget"
            break

        loaded_from_path = 0
        for episode in iter_episode_records(path):
            replay_episodes.append(episode)
            loaded_from_path += 1

            if loaded_from_path >= effective_per_file:
                stop_reason = "per_file_budget"
                break
            if len(replay_episodes) >= max_total:
                stop_reason = "total_budget"
                break
            if (
                loaded_from_path % _REPLAY_MEMORY_CHECK_INTERVAL == 0
                and _replay_memory_pressure_hard()
            ):
                stop_reason = "memory_pressure"
                break

        loaded_paths += 1
        if stop_reason in {"total_budget", "dynamic_budget", "memory_pressure"}:
            break
        stop_reason = None

    if stop_reason is not None or loaded_paths < len(paths):
        print(
            "[replay-budget] "
            f"label={label} "
            f"episodes={len(replay_episodes)} "
            f"files={loaded_paths}/{len(paths)} "
            f"max_per_file={max_per_file} "
            f"max_total={max_total} "
            f"stop={stop_reason or 'completed'}",
            flush=True,
        )

    return tuple(replay_episodes)


def _compose_replay_buffer(
    *episode_groups: Sequence[EpisodeRecord],
    label: str,
) -> tuple[EpisodeRecord, ...]:
    _, max_total = _select_replay_load_limits()
    if max_total <= 0:
        return ()

    combined: list[EpisodeRecord] = []
    total_requested = 0
    for group in episode_groups:
        total_requested += len(group)
        remaining = max_total - len(combined)
        if remaining <= 0:
            break
        if len(group) <= remaining:
            combined.extend(group)
        else:
            combined.extend(group[:remaining])
            break

    if len(combined) < total_requested:
        print(
            "[replay-budget] "
            f"label={label} "
            f"episodes={len(combined)} "
            f"requested={total_requested} "
            f"max_total={max_total} "
            "stop=compose_budget",
            flush=True,
        )

    return tuple(combined)

def _load_recent_replay_episodes(
    workspace_path: Path,
    *,
    current_round: int,
    replay_round_window: int = 3,
) -> tuple[EpisodeRecord, ...]:
    return _load_replay_episodes_with_budget(
        _collect_recent_replay_paths(
            workspace_path,
            current_round=current_round,
            replay_round_window=replay_round_window,
            include_br=False,
        ),
        label="recent_replay",
    )


def _load_recent_p2sro_replay_episodes(
    workspace_path: Path,
    *,
    current_round: int,
    replay_round_window: int = 3,
) -> tuple[EpisodeRecord, ...]:
    return _load_replay_episodes_with_budget(
        _collect_recent_replay_paths(
            workspace_path,
            current_round=current_round,
            replay_round_window=replay_round_window,
            include_br=True,
        ),
        label="recent_p2sro_replay",
    )


_SELF_PLAY_INVALID_TERMINAL_RETRIES_ENV = "GITCG_SELF_PLAY_INVALID_TERMINAL_RETRIES"
_SELF_PLAY_INVALID_TERMINAL_RETRIES_DEFAULT = 8
_SELF_PLAY_RETRY_SEED_STRIDE = 1_000_003


def _self_play_retry_limit(job_metadata: dict[str, Any]) -> int:
    if not bool(job_metadata.get("retry_invalid_terminal")):
        return 0
    explicit = job_metadata.get("max_invalid_terminal_retries")
    if explicit is not None:
        try:
            return max(0, int(explicit))
        except (TypeError, ValueError):
            pass
    raw = os.environ.get(_SELF_PLAY_INVALID_TERMINAL_RETRIES_ENV)
    if raw is not None:
        try:
            return max(0, int(raw.strip()))
        except ValueError:
            pass
    return _SELF_PLAY_INVALID_TERMINAL_RETRIES_DEFAULT


def _all_player_characters_defeated(player: Any) -> bool:
    characters = tuple(getattr(player, "characters", ()) or ())
    return bool(characters) and all(bool(getattr(character, "defeated", False)) for character in characters)


def _episode_requires_self_play_retry(episode: EpisodeRecord) -> tuple[bool, str | None]:
    metadata = dict(episode.metadata or {})
    if bool(metadata.get("invalid_terminal")):
        return True, str(metadata.get("invalid_terminal_reason") or "invalid_terminal")
    if bool(metadata.get("truncated")):
        return True, str(metadata.get("truncation_reason") or "truncated_episode")

    final_state = episode.final_state
    phase = str(getattr(final_state, "phase", "") or "")
    if phase != "game_end":
        return True, f"terminal_phase={phase or 'unknown'}"

    players = tuple(getattr(final_state, "players", ()) or ())
    if len(players) != 2:
        return False, None

    winner = episode.winner
    if winner not in (0, 1):
        return False, None

    player0_all_defeated = _all_player_characters_defeated(players[0])
    player1_all_defeated = _all_player_characters_defeated(players[1])

    if winner == 0 and player1_all_defeated and not player0_all_defeated:
        return False, None
    if winner == 1 and player0_all_defeated and not player1_all_defeated:
        return False, None
    return True, f"inconsistent_final_winner={winner}"


def collect_bootstrap_episodes(
    *,
    config: EnvConfig,
    matchups: Sequence[Matchup],
    episodes_per_matchup: int,
    seed_start: int,
    max_decisions: int | None,
    output_path: str | Path,
    workers: int = 1,
    progress_callback: BootstrapProgressCallback | None = None,
) -> tuple[EpisodeRecord, ...]:
    scripted_mirror = max(1, episodes_per_matchup // 2)
    scripted_vs_random = max(0, episodes_per_matchup - scripted_mirror)
    jobs: list[_EpisodeJob] = []
    total = len(matchups) * (scripted_mirror + scripted_vs_random)
    for matchup_index, matchup in enumerate(matchups):
        for local_index in range(scripted_mirror):
            seed = seed_start + matchup_index * episodes_per_matchup + local_index
            jobs.append(
                _EpisodeJob(
                    job_index=len(jobs),
                    matchup=matchup,
                    seed=seed,
                    agent0_factory=lambda _seed: _TaggedAgent(
                        ScriptedBootstrapAgent(),
                        trainable=True,
                        tag="bootstrap_scripted",
                    ),
                    agent1_factory=lambda _seed: _TaggedAgent(
                        ScriptedBootstrapAgent(),
                        trainable=True,
                        tag="bootstrap_scripted",
                    ),
                    metadata={},
                )
            )
        for local_index in range(scripted_vs_random):
            seed = seed_start + matchup_index * episodes_per_matchup + scripted_mirror + local_index
            jobs.append(
                _EpisodeJob(
                    job_index=len(jobs),
                    matchup=matchup,
                    seed=seed,
                    agent0_factory=lambda _seed: _TaggedAgent(
                        ScriptedBootstrapAgent(),
                        trainable=True,
                        tag="bootstrap_scripted",
                    ),
                    agent1_factory=lambda inner_seed: _TaggedAgent(
                        LegalRandomAgent(seed=inner_seed),
                        trainable=False,
                        tag="bootstrap_random",
                    ),
                    metadata={},
                )
            )

    def callback(done: int, all_jobs: int, result: _EpisodeJobResult) -> None:
        if progress_callback is not None:
            progress_callback(done, total, result.episode)

    return _execute_episode_jobs(
        config=config,
        jobs=jobs,
        max_decisions=max_decisions,
        workers=workers,
        output_path=output_path,
        progress_callback=callback,
    )




def _payoff_from_counts(*, wins: int, losses: int, draws: int, episodes: int) -> float:
    if episodes <= 0:
        return 0.0
    return float(wins - losses - draws) / float(episodes)


def collect_p2sro_training_episodes(
    *,
    config: EnvConfig,
    current_checkpoint: str | Path,
    frozen_population: Sequence[PolicyEntry],
    meta_strategy: MetaStrategySnapshot,
    matchups: Sequence[Matchup],
    episodes_per_matchup: int,
    seed_start: int,
    max_decisions: int | None,
    device: str,
    output_path: str | Path,
    workers: int = 1,
    inference_server: GpuInferenceServer | None = None,
    progress_callback: SelfPlayProgressCallback | None = None,
) -> tuple[EpisodeRecord, ...]:
    cache: dict[tuple[str, str], tuple[Any, Any]] = {}
    total = len(matchups) * episodes_per_matchup
    jobs: list[_EpisodeJob] = []
    frozen_entries = tuple(frozen_population)
    if not frozen_entries:
        raise RuntimeError("P2SRO training requires a non-empty frozen population")
    temp_manager = P2SROManager(state_path=Path("."), frozen_population={entry.policy_id: entry for entry in frozen_entries})
    temp_manager.meta_strategy = meta_strategy
    for matchup_index, matchup in enumerate(matchups):
        for local_index in range(episodes_per_matchup):
            seed = seed_start + matchup_index * episodes_per_matchup + local_index
            opponent_entry = temp_manager.sample_policy(seed=seed)
            jobs.append(
                _EpisodeJob(
                    job_index=len(jobs),
                    matchup=matchup,
                    seed=seed,
                    agent0_factory=build_checkpoint_agent_factory(
                        checkpoint_path=current_checkpoint,
                        device=device,
                        sample=True,
                        temperature=1.0,
                        player_id=0,
                        trainable=True,
                        tag="active_slot",
                        opponent_tag="meta_population",
                        opponent_entity_key=opponent_entry.policy_id,
                        opponent_deck_name=matchup.deck1,
                        cache=cache,
                        inference_server=inference_server,
                        env_config=config,
                    ),
                    agent1_factory=build_opponent_factory(
                        "current",
                        opponent_entry.checkpoint_path,
                        device=device,
                        sample=True,
                        temperature=1.0,
                        opponent_entity_key="active_slot",
                        opponent_deck_name=matchup.deck0,
                        observed_opponent_tag="active_population_slot",
                        cache=cache,
                        inference_server=inference_server,
                        env_config=config,
                    ),
                    metadata={
                        "opponent_kind": "frozen_population",
                        "opponent_policy_id": opponent_entry.policy_id,
                        "opponent_source": opponent_entry.checkpoint_path,
                        "matchup": matchup.key,
                        "retry_invalid_terminal": True,
                    },
                )
            )

    def callback(done: int, all_jobs: int, result: _EpisodeJobResult) -> None:
        if progress_callback is not None:
            progress_callback(
                done,
                total,
                result.episode,
                f"frozen:{result.job.metadata['opponent_policy_id']}",
            )

    return _execute_episode_jobs(
        config=config,
        jobs=jobs,
        max_decisions=max_decisions,
        workers=workers,
        output_path=output_path,
        progress_callback=callback,
    )


def _evaluate_checkpoint_against_population(
    *,
    checkpoint_path: Path,
    frozen_population: Sequence[PolicyEntry],
    meta_strategy: MetaStrategySnapshot,
    env_config: EnvConfig,
    matchups: Sequence[Matchup],
    device: str,
    max_decisions: int | None,
    workers: int,
    cache: dict[tuple[str, str], tuple[Any, Any]],
    inference_server: GpuInferenceServer | None,
    episodes_per_matchup: int,
    seed_start: int,
    output_dir: Path | None = None,
    progress_callback: Callable[[int, int, EpisodeRecord, str], None] | None = None,
) -> tuple[float, dict[str, float], tuple[dict[str, object], ...]]:
    per_policy_payoffs: dict[str, float] = {}
    matchup_payloads: list[dict[str, object]] = []
    meta_expected_payoff = 0.0
    for policy_index, opponent_entry in enumerate(frozen_population):
        jobs: list[_EpisodeJob] = []
        for episode_index in range(episodes_per_matchup):
            for matchup_index, matchup in enumerate(matchups):
                seed = (
                    seed_start
                    + policy_index * 10_000
                    + matchup_index * episodes_per_matchup
                    + episode_index
                )
                jobs.append(
                    _EpisodeJob(
                        job_index=len(jobs),
                        matchup=matchup,
                        seed=seed,
                        agent0_factory=build_checkpoint_agent_factory(
                            checkpoint_path=checkpoint_path,
                            device=device,
                            sample=False,
                            temperature=1.0,
                            player_id=0,
                            trainable=False,
                            tag="candidate_eval",
                            opponent_tag="frozen_population",
                            opponent_entity_key=opponent_entry.policy_id,
                            opponent_deck_name=matchup.deck1,
                            cache=cache,
                            inference_server=inference_server,
                            env_config=env_config,
                        ),
                        agent1_factory=build_opponent_factory(
                            "current",
                            opponent_entry.checkpoint_path,
                            device=device,
                            sample=False,
                            temperature=1.0,
                            opponent_entity_key="candidate_eval",
                            opponent_deck_name=matchup.deck0,
                            observed_opponent_tag="active_population_slot",
                            cache=cache,
                            inference_server=inference_server,
                            env_config=env_config,
                        ),
                        metadata={
                            "opponent_policy_id": opponent_entry.policy_id,
                            "opponent_source": opponent_entry.checkpoint_path,
                            "matchup": matchup.key,
                        },
                    )
                )
        eval_output_path = (
            output_dir / f"{opponent_entry.policy_id}.jsonl"
            if output_dir is not None
            else None
        )
        flush_threshold = _benchmark_eval_flush_threshold(len(jobs))
        episodes = _execute_episode_jobs(
            config=env_config,
            jobs=jobs,
            max_decisions=max_decisions,
            workers=_benchmark_eval_workers(workers),
            output_path=eval_output_path,
            progress_callback=(
                (lambda done, total, result, opponent_policy_id=opponent_entry.policy_id:
                    progress_callback(done, total, result.episode, opponent_policy_id))
                if progress_callback is not None else None
            ),
            flush_threshold=flush_threshold,
            load_persisted_episodes=_load_benchmark_cache_episodes,
            persist_episodes=_append_benchmark_cache_episodes,
        )
        wins = sum(1 for episode in episodes if episode.winner == 0)
        losses = sum(1 for episode in episodes if episode.winner == 1)
        draws = sum(1 for episode in episodes if episode.winner not in {0, 1})
        payoff = _payoff_from_counts(
            wins=wins,
            losses=losses,
            draws=draws,
            episodes=len(episodes),
        )
        per_policy_payoffs[opponent_entry.policy_id] = payoff
        meta_expected_payoff += float(meta_strategy.probabilities.get(opponent_entry.policy_id, 0.0)) * payoff
        for matchup in matchups:
            matchup_episodes = tuple(episode for episode in episodes if episode.matchup == matchup.key)
            matchup_wins = sum(1 for episode in matchup_episodes if episode.winner == 0)
            matchup_losses = sum(1 for episode in matchup_episodes if episode.winner == 1)
            matchup_draws = sum(1 for episode in matchup_episodes if episode.winner not in {0, 1})
            matchup_payloads.append(
                {
                    "opponent_policy_id": opponent_entry.policy_id,
                    "matchup": matchup.key,
                    "episodes": len(matchup_episodes),
                    "wins": matchup_wins,
                    "losses": matchup_losses,
                    "draws": matchup_draws,
                    "payoff": _payoff_from_counts(
                        wins=matchup_wins,
                        losses=matchup_losses,
                        draws=matchup_draws,
                        episodes=len(matchup_episodes),
                    ),
                }
            )
    return meta_expected_payoff, per_policy_payoffs, tuple(matchup_payloads)


def _select_active_slot_checkpoint(
    *,
    train_dir: Path,
    train_artifacts: PpoTrainArtifacts,
    env_config: EnvConfig,
    matchups: Sequence[Matchup],
    device: str,
    max_decisions: int | None,
    seed_start: int,
    benchmark_config: BenchmarkConfig,
    frozen_population: Sequence[PolicyEntry],
    meta_strategy: MetaStrategySnapshot,
    workers: int,
    inference_server: GpuInferenceServer | None,
    enable_status_print: bool,
    round_index: int | None = None,
) -> tuple[Path, int, Path, _SlotCandidateEvaluation]:
    summary_payload = _load_training_summary_payload(train_artifacts.summary_path)
    shortlist_epochs, safe_epochs, fallback_reason = _shortlist_candidate_epochs(
        summary_payload,
        max_safe_kl=benchmark_config.max_safe_kl,
        shortlist_size=benchmark_config.shortlist_size,
    )
    if not shortlist_epochs:
        raise RuntimeError("no checkpoint candidates available for active slot selection")
    cache: dict[tuple[str, str], tuple[Any, Any]] = {}
    candidates: list[_SlotCandidateEvaluation] = []
    for epoch in shortlist_epochs:
        checkpoint_path = _candidate_checkpoint_path(train_dir, epoch)
        if not checkpoint_path.exists():
            raise FileNotFoundError(f"candidate checkpoint missing: {checkpoint_path}")
        selection_cache_dir = train_dir / "selection_cache" / f"epoch_{epoch:03d}"
        selection_cache_dir.mkdir(parents=True, exist_ok=True)
        expected_payoff, per_policy_payoffs, matchup_payloads = _evaluate_checkpoint_against_population(
            checkpoint_path=checkpoint_path,
            frozen_population=frozen_population,
            meta_strategy=meta_strategy,
            env_config=env_config,
            matchups=matchups,
            device=device,
            max_decisions=max_decisions,
            workers=workers,
            cache=cache,
            inference_server=inference_server,
            episodes_per_matchup=benchmark_config.episodes_per_matchup,
            seed_start=seed_start + epoch * 1_000,
            output_dir=selection_cache_dir,
            progress_callback=(
                (lambda done, total, episode, opponent_policy_id, eval_epoch=epoch:
                    print_episode_progress(
                        label=f"p2sro-selection-e{eval_epoch:03d}",
                        round_index=round_index or 0,
                        completed=done,
                        total=total,
                        episode=episode,
                        extra=f"frozen:{opponent_policy_id}",
                    ))
                if enable_status_print else None
            ),
        )
        candidate = _SlotCandidateEvaluation(
            epoch=epoch,
            checkpoint_path=str(checkpoint_path),
            expected_payoff_vs_meta=expected_payoff,
            matchup_results=matchup_payloads,
            per_policy_payoffs=per_policy_payoffs,
            meta_policy_probabilities=dict(meta_strategy.probabilities),
        )
        candidates.append(candidate)
        if enable_status_print:
            print(
                "[p2sro-selection] "
                f"epoch={epoch} "
                f"expected_payoff_vs_meta={expected_payoff:.4f}",
                flush=True,
            )
    selected = max(candidates, key=lambda item: (item.expected_payoff_vs_meta, item.epoch))
    deployment_checkpoint = Path(train_artifacts.deployment_checkpoint)
    selected_source = Path(selected.checkpoint_path)
    if selected_source.resolve() != deployment_checkpoint.resolve():
        shutil.copy2(selected_source, deployment_checkpoint)
    selected = replace(selected, checkpoint_path=str(deployment_checkpoint))
    selection_summary_path = train_dir / "selection_summary.json"
    atomic_write_json(
        selection_summary_path,
        {
            "selection_method": "expected_payoff_vs_meta",
            "safe_epochs": safe_epochs,
            "shortlist_epochs": shortlist_epochs,
            "fallback_reason": fallback_reason,
            "selected_epoch": selected.epoch,
            "selected_checkpoint": selected.checkpoint_path,
            "expected_payoff_vs_meta": selected.expected_payoff_vs_meta,
            "meta_policy_probabilities": dict(selected.meta_policy_probabilities),
            "candidates": [
                {
                    "epoch": item.epoch,
                    "checkpoint_path": item.checkpoint_path,
                    "expected_payoff_vs_meta": item.expected_payoff_vs_meta,
                    "per_policy_payoffs": dict(item.per_policy_payoffs),
                    "matchup_results": [dict(result) for result in item.matchup_results],
                }
                for item in candidates
            ],
        },
    )
    return deployment_checkpoint, selected.epoch, selection_summary_path, selected


def _update_p2sro_payoff_matrix(
    *,
    manager: P2SROManager,
    candidate_policy_id: str,
    candidate_checkpoint: Path,
    env_config: EnvConfig,
    matchups: Sequence[Matchup],
    device: str,
    max_decisions: int | None,
    workers: int,
    inference_server: GpuInferenceServer | None,
    episodes_per_matchup: int,
    seed_start: int,
    cache_dir: Path | None = None,
    round_index: int | None = None,
    enable_status_print: bool = False,
) -> dict[str, float]:
    cache: dict[tuple[str, str], tuple[Any, Any]] = {}
    per_policy_payoffs: dict[str, float] = {}
    if cache_dir is not None:
        cache_dir.mkdir(parents=True, exist_ok=True)
    for opponent_index, opponent_entry in enumerate(manager.frozen_entries()):
        jobs: list[_EpisodeJob] = []
        per_matchup_results: list[dict[str, object]] = []
        for episode_index in range(episodes_per_matchup):
            for matchup_index, matchup in enumerate(matchups):
                seed = (
                    seed_start
                    + opponent_index * 10_000
                    + matchup_index * episodes_per_matchup
                    + episode_index
                )
                jobs.append(
                    _EpisodeJob(
                        job_index=len(jobs),
                        matchup=matchup,
                        seed=seed,
                        agent0_factory=build_checkpoint_agent_factory(
                            checkpoint_path=candidate_checkpoint,
                            device=device,
                            sample=False,
                            temperature=1.0,
                            player_id=0,
                            trainable=False,
                            tag=f"payoff:{candidate_policy_id}",
                            opponent_tag="frozen_population",
                            opponent_entity_key=opponent_entry.policy_id,
                            opponent_deck_name=matchup.deck1,
                            cache=cache,
                            inference_server=inference_server,
                            env_config=env_config,
                        ),
                        agent1_factory=build_opponent_factory(
                            "current",
                            opponent_entry.checkpoint_path,
                            device=device,
                            sample=False,
                            temperature=1.0,
                            opponent_entity_key=candidate_policy_id,
                            opponent_deck_name=matchup.deck0,
                            observed_opponent_tag="active_population_slot",
                            cache=cache,
                            inference_server=inference_server,
                            env_config=env_config,
                        ),
                        metadata={
                            "candidate_policy_id": candidate_policy_id,
                            "opponent_policy_id": opponent_entry.policy_id,
                            "matchup": matchup.key,
                        },
                    )
                )
        payoff_output_path = (
            cache_dir / f"{candidate_policy_id}__vs__{opponent_entry.policy_id}.jsonl"
            if cache_dir is not None
            else None
        )
        flush_threshold = _benchmark_eval_flush_threshold(len(jobs))
        episodes = _execute_episode_jobs(
            config=env_config,
            jobs=jobs,
            max_decisions=max_decisions,
            workers=_benchmark_eval_workers(workers),
            output_path=payoff_output_path,
            progress_callback=(
                (lambda done, total, result, opponent_policy_id=opponent_entry.policy_id:
                    print_episode_progress(
                        label=f"p2sro-payoff-{candidate_policy_id}",
                        round_index=round_index or 0,
                        completed=done,
                        total=total,
                        episode=result.episode,
                        extra=f"frozen:{opponent_policy_id}",
                    ))
                if enable_status_print else None
            ),
            flush_threshold=flush_threshold,
            load_persisted_episodes=_load_benchmark_cache_episodes,
            persist_episodes=_append_benchmark_cache_episodes,
        )
        wins = sum(1 for episode in episodes if episode.winner == 0)
        losses = sum(1 for episode in episodes if episode.winner == 1)
        draws = sum(1 for episode in episodes if episode.winner not in {0, 1})
        candidate_payoff = _payoff_from_counts(
            wins=wins,
            losses=losses,
            draws=draws,
            episodes=len(episodes),
        )
        per_policy_payoffs[opponent_entry.policy_id] = candidate_payoff
        for matchup in matchups:
            matchup_episodes = tuple(episode for episode in episodes if episode.matchup == matchup.key)
            matchup_wins = sum(1 for episode in matchup_episodes if episode.winner == 0)
            matchup_losses = sum(1 for episode in matchup_episodes if episode.winner == 1)
            matchup_draws = sum(1 for episode in matchup_episodes if episode.winner not in {0, 1})
            per_matchup_results.append(
                {
                    "matchup": matchup.key,
                    "episodes": len(matchup_episodes),
                    "wins": matchup_wins,
                    "losses": matchup_losses,
                    "draws": matchup_draws,
                    "payoff": _payoff_from_counts(
                        wins=matchup_wins,
                        losses=matchup_losses,
                        draws=matchup_draws,
                        episodes=len(matchup_episodes),
                    ),
                }
            )
        opponent_payoff = _payoff_from_counts(
            wins=losses,
            losses=wins,
            draws=draws,
            episodes=len(episodes),
        )
        manager.payoff_matrix.set_pair(
            row_policy_id=candidate_policy_id,
            col_policy_id=opponent_entry.policy_id,
            row_result=PayoffResult(
                episodes=len(episodes),
                wins=wins,
                losses=losses,
                draws=draws,
                payoff=candidate_payoff,
                matchup_results=tuple(per_matchup_results),
            ),
            col_result=PayoffResult(
                episodes=len(episodes),
                wins=losses,
                losses=wins,
                draws=draws,
                payoff=opponent_payoff,
                matchup_results=tuple(
                    {
                        "matchup": item["matchup"],
                        "episodes": item["episodes"],
                        "wins": item["losses"],
                        "losses": item["wins"],
                        "draws": item["draws"],
                        "payoff": _payoff_from_counts(
                            wins=int(item["losses"]),
                            losses=int(item["wins"]),
                            draws=int(item["draws"]),
                            episodes=int(item["episodes"]),
                        ),
                    }
                    for item in per_matchup_results
                ),
            ),
        )
    return per_policy_payoffs







def run_ppo_managed_loop(
    *,
    workspace: str | Path,
    rounds: int = 20,
    init_checkpoint: str | Path | None = None,
    bootstrap_episodes_per_matchup: int = 8,
    self_play_episodes_per_matchup: int = 8,
    max_rounds: int = 15,
    max_decisions: int | None = 512,
    draw_penalty: float = 1.0,
    batch_size: int = 64,
    micro_batch_size: int | None = None,
    epochs: int = 12,
    bootstrap_epochs: int = 5,
    learning_rate: float = 1.0e-3,
    weight_decay: float = 1e-4,
    grad_clip_norm: float | None = 1.0,
    gamma: float = 0.99,
    gae_lambda: float = 0.95,
    entropy_coef: float = 0.01,
    policy_coef: float = 4.0,
    value_coef: float = 0.5,
    belief_coef: float = 0.2,
    oracle_coef: float = 0.2,
    reference_kl_coef: float = 0.005,
    target_kl_low: float = 0.01,
    target_kl_high: float = 0.05,
    use_amp: bool | None = None,
    device: str = "auto",
    workers: int = 8,
    inference_max_batch_size: int = 128,
    inference_max_wait_ms: int = 2,
    seed_start: int = 0,
    resume: bool = True,
    enable_status_print: bool = True,
    retain_round_directories: int | None = 6,
    benchmark_config: BenchmarkConfig | None = None,
    checkpoint_selection_config: BenchmarkConfig | None = None,
    p2sro_config: P2SROConfig | None = None,
    matchups: tuple[Matchup, ...] = SMALL_DECK_MATCHUPS,
) -> PpoManagedLoopArtifacts:
    workspace_path = Path(workspace)
    workspace_path.mkdir(parents=True, exist_ok=True)
    status_path = workspace_path / "event_loop_status.json"
    history_path = workspace_path / "event_loop_history.jsonl"
    state_path = workspace_path / "event_loop_state.json"
    manifest_path = workspace_path / "run_manifest.json"
    result_path = workspace_path / "event_loop_result.json"
    deployment_manifest_path = workspace_path / "meta_deployment.json"
    p2sro_state_path = workspace_path / "p2sro_state.json"
    write_runtime_manifest(manifest_path, workspace=workspace_path)
    tracker = ProgressTracker(
        status_path=status_path,
        event_log_path=history_path,
        overall_total_units=max(1, rounds * 5),
        worker_count=max(1, workers),
        enable_print=enable_status_print,
    )

    def _persist_phase_state(
        *,
        working_checkpoint: Path | None,
        completed_round: int,
        current_round: int | None,
        current_phase: str | None,
    ) -> None:
        _save_loop_state(
            state_path,
            working_checkpoint=working_checkpoint,
            completed_round=completed_round,
            current_round=current_round,
            current_phase=current_phase,
            p2sro_state_path=p2sro_state_path,
            meta_strategy_path=deployment_manifest_path,
        )

    def _episode_phase_callback(
        *,
        phase: str,
        round_index: int,
        phase_total_units: int,
        phase_overall_units: int,
        artifacts: dict[str, str],
        label: str,
    ) -> Callable[[int, int, EpisodeRecord], None]:
        def callback(done: int, total: int, episode: EpisodeRecord) -> None:
            tracker.update_phase(
                phase,
                completed_units=done,
                total_units=phase_total_units,
                current_task=f"round_{round_index:04d} {done}/{total} {episode.matchup}",
                overall_completed_units=phase_overall_units,
                artifacts=artifacts,
                details={
                    "last_matchup": episode.matchup,
                    "last_winner": episode.winner,
                    "last_steps": len(episode.steps),
                    "last_truncated": bool(episode.metadata.get("truncated")),
                },
            )
            if enable_status_print:
                print_episode_progress(
                    label=label,
                    round_index=round_index,
                    completed=done,
                    total=total,
                    episode=episode,
                )

        return callback

    def _self_play_phase_callback(
        *,
        phase: str,
        round_index: int,
        phase_total_units: int,
        phase_overall_units: int,
        artifacts: dict[str, str],
        label: str,
    ) -> SelfPlayProgressCallback:
        def callback(done: int, total: int, episode: EpisodeRecord, opponent_label: str) -> None:
            tracker.update_phase(
                phase,
                completed_units=done,
                total_units=phase_total_units,
                current_task=f"round_{round_index:04d} {done}/{total} {episode.matchup}",
                overall_completed_units=phase_overall_units,
                artifacts=artifacts,
                details={
                    "last_matchup": episode.matchup,
                    "last_winner": episode.winner,
                    "last_steps": len(episode.steps),
                    "last_truncated": bool(episode.metadata.get("truncated")),
                    "last_opponent": opponent_label,
                },
            )
            if enable_status_print:
                print_episode_progress(
                    label=label,
                    round_index=round_index,
                    completed=done,
                    total=total,
                    episode=episode,
                    extra=opponent_label,
                )

        return callback

    def _training_phase_callback(
        *,
        phase: str,
        round_index: int,
        episode_units: int,
        phase_total_units: int,
        phase_overall_units: int,
        artifacts: dict[str, str],
        label: str,
    ) -> Callable[[int, int, PpoTrainingMetrics, bool], None]:
        def callback(epoch_index: int, epoch_total: int, metrics: PpoTrainingMetrics, is_best: bool) -> None:
            tracker.update_phase(
                phase,
                completed_units=episode_units + epoch_index,
                total_units=phase_total_units,
                current_task=f"round_{round_index:04d} epoch={epoch_index}/{epoch_total}",
                overall_completed_units=phase_overall_units,
                artifacts=artifacts,
                details={
                    "epoch": epoch_index,
                    "epochs": epoch_total,
                    "total_loss": metrics.total_loss,
                    "approx_kl": metrics.approx_kl,
                    "best": is_best,
                },
            )
            if enable_status_print:
                print(
                    f"[{label}] "
                    f"round={round_index:04d} "
                    f"epoch={epoch_index}/{epoch_total} "
                    f"loss={metrics.total_loss:.4f} "
                    f"kl={metrics.approx_kl:.4f} "
                    f"best={is_best}",
                    flush=True,
                )

        return callback
    state = _load_loop_state(state_path) if resume else _LoopState(
        working_checkpoint=None,
        completed_round=0,
    )
    resume_cursor: _ResumeCursor | None = None
    if resume:
        if state.current_round is not None and state.current_phase is not None:
            resume_cursor = _ResumeCursor(
                round_index=state.current_round,
                phase=state.current_phase,
            )
        else:
            resume_cursor = _infer_resume_cursor(
                workspace_path,
                rounds=rounds,
                initial_checkpoint=state.working_checkpoint or (Path(init_checkpoint) if init_checkpoint is not None else None),
                completed_round=state.completed_round,
            )
        if resume_cursor is not None:
            _prepare_round_for_resume(workspace_path, resume_cursor.round_index, resume_cursor.phase)
    start_round = resume_cursor.round_index if resume_cursor is not None else max(1, state.completed_round + 1)
    current_training_checkpoint = _resolve_initial_checkpoint(init_checkpoint, state)
    resolved_device = auto_device(device)
    resolved_benchmark_config = benchmark_config or checkpoint_selection_config or BenchmarkConfig()
    env_config = EnvConfig(
        deck_pool=SMALL_DECK_POOL,
        max_rounds=max_rounds,
        record_full_state_json=True,
        record_player_view=True,
        draw_penalty=draw_penalty,
    )
    manager = P2SROManager.load(p2sro_state_path, config=p2sro_config or P2SROConfig())
    round_results = _load_completed_round_results(workspace_path)
    resolved_workers = _recommended_rollout_workers(max(1, workers), current_training_checkpoint)
    inference_server = (
        GpuInferenceServer(
            device=resolved_device,
            config=InferenceServerConfig(
                max_batch_size=inference_max_batch_size,
                max_wait_ms=inference_max_wait_ms,
            ),
        )
        if resolved_workers > 1
        else None
    )
    for round_index in range(start_round, rounds + 1):
        round_resume_phase = (
            resume_cursor.phase
            if resume_cursor is not None and round_index == resume_cursor.round_index
            else None
        )
        round_dir = workspace_path / f"round_{round_index:04d}"
        round_dir.mkdir(parents=True, exist_ok=True)
        bootstrap_path = round_dir / "bootstrap.jsonl"
        bootstrap_analysis_path = round_dir / "bootstrap_analysis.json"
        bootstrap_train_dir = round_dir / "bootstrap_train"
        self_play_path = round_dir / "self_play.jsonl"
        self_play_analysis_path = round_dir / "self_play_analysis.json"
        train_dir = round_dir / "train"
        br_self_play_path = round_dir / "br_self_play.jsonl"
        br_self_play_analysis_path = round_dir / "br_self_play_analysis.json"
        br_train_dir = round_dir / "br_train"
        analysis_path = round_dir / "analysis.json"
        round_base_checkpoint = _round_base_checkpoint(
            round_dir=round_dir,
            fallback=current_training_checkpoint,
        )
        if round_base_checkpoint is None:
            total_bootstrap = len(matchups) * bootstrap_episodes_per_matchup
            bootstrap_phase_total = total_bootstrap + bootstrap_epochs
            bootstrap_phase_artifacts = {"bootstrap_path": str(bootstrap_path)}
            _persist_phase_state(
                working_checkpoint=current_training_checkpoint,
                completed_round=round_index - 1,
                current_round=round_index,
                current_phase="bootstrap",
            )
            tracker.start_phase(
                "bootstrap",
                total_units=bootstrap_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5,
                artifacts=bootstrap_phase_artifacts,
            )
            bootstrap_episodes = collect_bootstrap_episodes(
                config=env_config,
                matchups=matchups,
                episodes_per_matchup=bootstrap_episodes_per_matchup,
                seed_start=seed_start + (round_index * 100_000),
                max_decisions=max_decisions,
                output_path=bootstrap_path,
                workers=resolved_workers,
                progress_callback=_episode_phase_callback(
                    phase="bootstrap",
                    round_index=round_index,
                    phase_total_units=bootstrap_phase_total,
                    phase_overall_units=(round_index - 1) * 5,
                    artifacts=bootstrap_phase_artifacts,
                    label="bootstrap",
                ),
            )
            bootstrap_analysis = analyze_episode_records(bootstrap_episodes, player=0)
            write_episode_analysis(
                bootstrap_analysis_path,
                phase="bootstrap",
                round_index=round_index,
                analytics=bootstrap_analysis,
            )
            bootstrap_artifacts = bootstrap_pretrain_from_episodes(
                episodes=bootstrap_episodes,
                output_dir=bootstrap_train_dir,
                init_checkpoint=None,
                device=resolved_device,
                batch_size=batch_size,
                micro_batch_size=micro_batch_size,
                epochs=bootstrap_epochs,
                learning_rate=learning_rate,
                weight_decay=weight_decay,
                grad_clip_norm=grad_clip_norm,
                use_amp=use_amp,
                progress_callback=_training_phase_callback(
                    phase="bootstrap",
                    round_index=round_index,
                    episode_units=total_bootstrap,
                    phase_total_units=bootstrap_phase_total,
                    phase_overall_units=(round_index - 1) * 5,
                    artifacts={
                        **bootstrap_phase_artifacts,
                        "bootstrap_train_dir": str(bootstrap_train_dir),
                    },
                    label="bootstrap-train",
                ),
            )
            round_base_checkpoint = Path(bootstrap_artifacts.deployment_checkpoint)
            tracker.complete_phase(
                "bootstrap",
                total_units=bootstrap_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5 + 1,
                artifacts={
                    "bootstrap_path": str(bootstrap_path),
                    "bootstrap_train_dir": str(bootstrap_train_dir),
                },
                details={
                    "episodes": bootstrap_analysis.episodes,
                    "player0_wins": bootstrap_analysis.player0_wins,
                    "player1_wins": bootstrap_analysis.player1_wins,
                    "draws": bootstrap_analysis.draws,
                },
            )

        assert round_base_checkpoint is not None
        main_seed_checkpoint = _deployment_from_training_checkpoint(round_base_checkpoint)
        if not main_seed_checkpoint.exists():
            raise FileNotFoundError(f"missing active main seed checkpoint: {main_seed_checkpoint}")
        meta_snapshot = manager.recompute_meta_strategy()
        main_phase_total = (len(matchups) * self_play_episodes_per_matchup) + epochs
        main_phase_artifacts = {"self_play_path": str(self_play_path), "train_dir": str(train_dir)}
        should_reuse_main_slot = (
            _phase_rank(round_resume_phase) >= _phase_rank("active_main_slot")
            and self_play_path.exists()
        )
        main_resume = _load_completed_slot_artifacts(train_dir) if should_reuse_main_slot else None
        partial_main_train_artifacts = _load_partial_slot_train_artifacts(train_dir) if should_reuse_main_slot else None
        if manager.active_main_slot is None or manager.active_main_slot.seed_checkpoint_path != str(main_seed_checkpoint):
            if main_resume is None and partial_main_train_artifacts is None:
                seed_entry = manager.initialize_seed_population(
                    seed_checkpoint_path=str(main_seed_checkpoint),
                    round_index=round_index,
                )
                manager.set_active_slot_seed(
                    slot_name="active_main_slot",
                    lineage="main",
                    checkpoint_path=str(main_seed_checkpoint),
                    seed_policy_id=seed_entry.policy_id,
                    parent_policy_id=seed_entry.policy_id,
                )
                manager.save()
            else:
                fallback_seed_policy_id = (
                    manager.active_main_slot.seed_policy_id
                    if manager.active_main_slot is not None
                    else None
                )
                manager.set_active_slot_seed(
                    slot_name="active_main_slot",
                    lineage="main",
                    checkpoint_path=str(main_seed_checkpoint),
                    seed_policy_id=fallback_seed_policy_id,
                    parent_policy_id=fallback_seed_policy_id,
                )
                manager.save()
        if main_resume is None and partial_main_train_artifacts is None:
            _persist_phase_state(
                working_checkpoint=main_seed_checkpoint,
                completed_round=round_index - 1,
                current_round=round_index,
                current_phase="active_main_slot",
            )
            tracker.start_phase(
                "active_main_slot",
                total_units=main_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5 + 1,
                artifacts=main_phase_artifacts,
            )
            self_play_episodes = collect_p2sro_training_episodes(
                config=env_config,
                current_checkpoint=main_seed_checkpoint,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                matchups=matchups,
                episodes_per_matchup=self_play_episodes_per_matchup,
                seed_start=seed_start + round_index * 10_000,
                max_decisions=max_decisions,
                device=resolved_device,
                output_path=self_play_path,
                workers=resolved_workers,
                inference_server=inference_server,
                progress_callback=_self_play_phase_callback(
                    phase="active_main_slot",
                    round_index=round_index,
                    phase_total_units=main_phase_total,
                    phase_overall_units=(round_index - 1) * 5 + 1,
                    artifacts=main_phase_artifacts,
                    label="active-main-episode",
                ),
            )
            self_play_analysis = analyze_episode_records(self_play_episodes, player=0)
            write_episode_analysis(
                self_play_analysis_path,
                phase="self_play",
                round_index=round_index,
                analytics=self_play_analysis,
            )
            replay_episodes = _load_recent_p2sro_replay_episodes(
                workspace_path,
                current_round=round_index,
                replay_round_window=3,
            )
            main_train_artifacts = train_ppo_from_episodes(
                episodes=self_play_episodes,
                replay_episodes=replay_episodes,
                output_dir=train_dir,
                init_checkpoint=main_seed_checkpoint,
                env_config=env_config,
                device=resolved_device,
                batch_size=batch_size,
                micro_batch_size=micro_batch_size,
                epochs=epochs,
                learning_rate=learning_rate,
                weight_decay=weight_decay,
                grad_clip_norm=grad_clip_norm,
                gamma=gamma,
                gae_lambda=gae_lambda,
                entropy_coef=entropy_coef,
                policy_coef=policy_coef,
                value_coef=value_coef,
                belief_coef=belief_coef,
                oracle_coef=oracle_coef,
                reference_kl_coef=reference_kl_coef,
                target_kl_low=target_kl_low,
                target_kl_high=target_kl_high,
                use_amp=use_amp,
                progress_callback=_training_phase_callback(
                    phase="active_main_slot",
                    round_index=round_index,
                    episode_units=len(matchups) * self_play_episodes_per_matchup,
                    phase_total_units=main_phase_total,
                    phase_overall_units=(round_index - 1) * 5 + 1,
                    artifacts=main_phase_artifacts,
                    label="active-main-train",
                ),
            )
            selected_main_checkpoint, selected_main_epoch, main_selection_path, selected_main_candidate = _select_active_slot_checkpoint(
                train_dir=train_dir,
                train_artifacts=main_train_artifacts,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                seed_start=seed_start + round_index * 30_000,
                benchmark_config=resolved_benchmark_config,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                workers=resolved_workers,
                inference_server=inference_server,
                enable_status_print=enable_status_print,
                round_index=round_index,
            )
            main_slot_state = manager.update_active_slot_result(
                slot_name="active_main_slot",
                selected_epoch=selected_main_epoch,
                selected_checkpoint_path=str(selected_main_checkpoint),
                expected_payoff_vs_meta=selected_main_candidate.expected_payoff_vs_meta,
            )
            manager.save()
            tracker.complete_phase(
                "active_main_slot",
                total_units=main_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5 + 2,
                artifacts={
                    "self_play_path": str(self_play_path),
                    "train_dir": str(train_dir),
                    "selection_path": str(main_selection_path),
                },
                details={
                    "selected_epoch": selected_main_epoch,
                    "selected_checkpoint": str(selected_main_checkpoint),
                    "expected_payoff_vs_meta": selected_main_candidate.expected_payoff_vs_meta,
                },
            )
        elif partial_main_train_artifacts is not None and main_resume is None:
            main_train_artifacts = partial_main_train_artifacts
            self_play_episodes = load_episode_records(self_play_path)
            self_play_analysis = analyze_episode_records(self_play_episodes, player=0)
            replay_episodes = _load_recent_p2sro_replay_episodes(
                workspace_path,
                current_round=round_index,
                replay_round_window=3,
            )
            selected_main_checkpoint, selected_main_epoch, main_selection_path, selected_main_candidate = _select_active_slot_checkpoint(
                train_dir=train_dir,
                train_artifacts=main_train_artifacts,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                seed_start=seed_start + round_index * 30_000,
                benchmark_config=resolved_benchmark_config,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                workers=resolved_workers,
                inference_server=inference_server,
                enable_status_print=enable_status_print,
                round_index=round_index,
            )
            main_slot_state = manager.update_active_slot_result(
                slot_name="active_main_slot",
                selected_epoch=selected_main_epoch,
                selected_checkpoint_path=str(selected_main_checkpoint),
                expected_payoff_vs_meta=selected_main_candidate.expected_payoff_vs_meta,
            )
            manager.save()
        else:
            main_train_artifacts = load_ppo_train_artifacts(train_dir)
            if main_train_artifacts is None:
                raise RuntimeError(f"missing main train artifacts for resume: {train_dir}")
            self_play_episodes = load_episode_records(self_play_path)
            self_play_analysis = analyze_episode_records(self_play_episodes, player=0)
            replay_episodes = _load_recent_p2sro_replay_episodes(
                workspace_path,
                current_round=round_index,
                replay_round_window=3,
            )
            selected_main_checkpoint, selected_main_epoch, main_selection_path, selected_main_candidate = main_resume
            if manager.active_main_slot is None or manager.active_main_slot.selected_checkpoint_path != str(selected_main_checkpoint):
                main_slot_state = manager.update_active_slot_result(
                    slot_name="active_main_slot",
                    selected_epoch=selected_main_epoch,
                    selected_checkpoint_path=str(selected_main_checkpoint),
                    expected_payoff_vs_meta=selected_main_candidate.expected_payoff_vs_meta,
                )
                manager.save()
            else:
                main_slot_state = manager.active_main_slot
        br_slot_state = manager.set_active_slot_seed(
            slot_name="active_br_slot",
            lineage="best_response",
            checkpoint_path=str(selected_main_checkpoint),
            seed_policy_id=main_slot_state.seed_policy_id,
            parent_policy_id=main_slot_state.parent_policy_id,
        )
        manager.save()
        br_phase_total = (len(matchups) * self_play_episodes_per_matchup) + epochs
        br_phase_artifacts = {"self_play_path": str(br_self_play_path), "train_dir": str(br_train_dir)}
        should_reuse_br_slot = (
            _phase_rank(round_resume_phase) >= _phase_rank("active_br_slot")
            and br_self_play_path.exists()
        )
        br_resume = _load_completed_slot_artifacts(br_train_dir) if should_reuse_br_slot else None
        partial_br_train_artifacts = _load_partial_slot_train_artifacts(br_train_dir) if should_reuse_br_slot else None
        if br_resume is None and partial_br_train_artifacts is None:
            _persist_phase_state(
                working_checkpoint=selected_main_checkpoint,
                completed_round=round_index - 1,
                current_round=round_index,
                current_phase="active_br_slot",
            )
            tracker.start_phase(
                "active_br_slot",
                total_units=br_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5 + 2,
                artifacts=br_phase_artifacts,
            )
            br_self_play_episodes = collect_p2sro_training_episodes(
                config=env_config,
                current_checkpoint=selected_main_checkpoint,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                matchups=matchups,
                episodes_per_matchup=self_play_episodes_per_matchup,
                seed_start=seed_start + round_index * 20_000,
                max_decisions=max_decisions,
                device=resolved_device,
                output_path=br_self_play_path,
                workers=resolved_workers,
                inference_server=inference_server,
                progress_callback=_self_play_phase_callback(
                    phase="active_br_slot",
                    round_index=round_index,
                    phase_total_units=br_phase_total,
                    phase_overall_units=(round_index - 1) * 5 + 2,
                    artifacts=br_phase_artifacts,
                    label="active-br-episode",
                ),
            )
            br_self_play_analysis = analyze_episode_records(br_self_play_episodes, player=0)
            write_episode_analysis(
                br_self_play_analysis_path,
                phase="br_self_play",
                round_index=round_index,
                analytics=br_self_play_analysis,
            )
            br_replay_episodes = _compose_replay_buffer(
                self_play_episodes,
                replay_episodes,
                label="br_train_replay",
            )
            br_train_artifacts = train_ppo_from_episodes(
                episodes=br_self_play_episodes,
                replay_episodes=br_replay_episodes,
                output_dir=br_train_dir,
                init_checkpoint=selected_main_checkpoint,
                env_config=env_config,
                device=resolved_device,
                batch_size=batch_size,
                micro_batch_size=micro_batch_size,
                epochs=epochs,
                learning_rate=learning_rate,
                weight_decay=weight_decay,
                grad_clip_norm=grad_clip_norm,
                gamma=gamma,
                gae_lambda=gae_lambda,
                entropy_coef=entropy_coef,
                policy_coef=policy_coef,
                value_coef=value_coef,
                belief_coef=belief_coef,
                oracle_coef=oracle_coef,
                reference_kl_coef=reference_kl_coef,
                target_kl_low=target_kl_low,
                target_kl_high=target_kl_high,
                use_amp=use_amp,
                progress_callback=_training_phase_callback(
                    phase="active_br_slot",
                    round_index=round_index,
                    episode_units=len(matchups) * self_play_episodes_per_matchup,
                    phase_total_units=br_phase_total,
                    phase_overall_units=(round_index - 1) * 5 + 2,
                    artifacts=br_phase_artifacts,
                    label="active-br-train",
                ),
            )
            selected_br_checkpoint, selected_br_epoch, br_selection_path, selected_br_candidate = _select_active_slot_checkpoint(
                train_dir=br_train_dir,
                train_artifacts=br_train_artifacts,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                seed_start=seed_start + round_index * 40_000,
                benchmark_config=resolved_benchmark_config,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                workers=resolved_workers,
                inference_server=inference_server,
                enable_status_print=enable_status_print,
                round_index=round_index,
            )
            br_slot_state = manager.update_active_slot_result(
                slot_name="active_br_slot",
                selected_epoch=selected_br_epoch,
                selected_checkpoint_path=str(selected_br_checkpoint),
                expected_payoff_vs_meta=selected_br_candidate.expected_payoff_vs_meta,
            )
            manager.save()
            tracker.complete_phase(
                "active_br_slot",
                total_units=br_phase_total,
                current_task=f"round_{round_index:04d}",
                overall_completed_units=(round_index - 1) * 5 + 3,
                artifacts={
                    "self_play_path": str(br_self_play_path),
                    "train_dir": str(br_train_dir),
                    "selection_path": str(br_selection_path),
                },
                details={
                    "selected_epoch": selected_br_epoch,
                    "selected_checkpoint": str(selected_br_checkpoint),
                    "expected_payoff_vs_meta": selected_br_candidate.expected_payoff_vs_meta,
                },
            )
        elif partial_br_train_artifacts is not None and br_resume is None:
            br_train_artifacts = partial_br_train_artifacts
            br_self_play_episodes = load_episode_records(br_self_play_path)
            br_self_play_analysis = analyze_episode_records(br_self_play_episodes, player=0)
            br_replay_episodes = tuple(replay_episodes) + tuple(self_play_episodes)
            selected_br_checkpoint, selected_br_epoch, br_selection_path, selected_br_candidate = _select_active_slot_checkpoint(
                train_dir=br_train_dir,
                train_artifacts=br_train_artifacts,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                seed_start=seed_start + round_index * 40_000,
                benchmark_config=resolved_benchmark_config,
                frozen_population=manager.frozen_entries(),
                meta_strategy=meta_snapshot,
                workers=resolved_workers,
                inference_server=inference_server,
                enable_status_print=enable_status_print,
                round_index=round_index,
            )
            br_slot_state = manager.update_active_slot_result(
                slot_name="active_br_slot",
                selected_epoch=selected_br_epoch,
                selected_checkpoint_path=str(selected_br_checkpoint),
                expected_payoff_vs_meta=selected_br_candidate.expected_payoff_vs_meta,
            )
            manager.save()
        else:
            br_train_artifacts = load_ppo_train_artifacts(br_train_dir)
            if br_train_artifacts is None:
                raise RuntimeError(f"missing best-response train artifacts for resume: {br_train_dir}")
            selected_br_checkpoint, selected_br_epoch, br_selection_path, selected_br_candidate = br_resume
            if manager.active_br_slot is None or manager.active_br_slot.selected_checkpoint_path != str(selected_br_checkpoint):
                br_slot_state = manager.update_active_slot_result(
                    slot_name="active_br_slot",
                    selected_epoch=selected_br_epoch,
                    selected_checkpoint_path=str(selected_br_checkpoint),
                    expected_payoff_vs_meta=selected_br_candidate.expected_payoff_vs_meta,
                )
                manager.save()
            else:
                br_slot_state = manager.active_br_slot
        _persist_phase_state(
            working_checkpoint=selected_main_checkpoint,
            completed_round=round_index - 1,
            current_round=round_index,
            current_phase="round_finalize",
        )
        promoted_entries: list[PolicyEntry] = []
        if manager.should_promote(lineage="main", candidate_payoff=selected_main_candidate.expected_payoff_vs_meta):
            promoted_main = manager.freeze_active_slot(
                slot_name="active_main_slot",
                round_index=round_index,
            )
            _update_p2sro_payoff_matrix(
                manager=manager,
                candidate_policy_id=promoted_main.policy_id,
                candidate_checkpoint=selected_main_checkpoint,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                workers=resolved_workers,
                inference_server=inference_server,
                episodes_per_matchup=resolved_benchmark_config.episodes_per_matchup,
                seed_start=seed_start + round_index * 50_000,
                cache_dir=round_dir / "payoff_cache",
                round_index=round_index,
                enable_status_print=enable_status_print,
            )
            promoted_entries.append(promoted_main)
        if manager.should_promote(lineage="best_response", candidate_payoff=selected_br_candidate.expected_payoff_vs_meta):
            promoted_br = manager.freeze_active_slot(
                slot_name="active_br_slot",
                round_index=round_index,
            )
            _update_p2sro_payoff_matrix(
                manager=manager,
                candidate_policy_id=promoted_br.policy_id,
                candidate_checkpoint=selected_br_checkpoint,
                env_config=env_config,
                matchups=matchups,
                device=resolved_device,
                max_decisions=max_decisions,
                workers=resolved_workers,
                inference_server=inference_server,
                episodes_per_matchup=resolved_benchmark_config.episodes_per_matchup,
                seed_start=seed_start + round_index * 60_000,
                cache_dir=round_dir / "payoff_cache",
                round_index=round_index,
                enable_status_print=enable_status_print,
            )
            promoted_entries.append(promoted_br)
        meta_snapshot = manager.recompute_meta_strategy()
        manager.save()
        atomic_write_json(
            deployment_manifest_path,
            {
                "round": round_index,
                "frozen_population": [entry.to_dict() for entry in manager.frozen_entries()],
                "meta_strategy": meta_snapshot.to_dict(),
                "active_main_slot": main_slot_state.to_dict(),
                "active_br_slot": br_slot_state.to_dict(),
            },
        )
        analysis_payload = {
            "round": round_index,
            "algorithm": "p2sro",
            "bootstrap_path": str(bootstrap_path) if bootstrap_path.exists() else None,
            "self_play_path": str(self_play_path),
            "br_self_play_path": str(br_self_play_path),
            "train_dir": str(train_dir),
            "br_train_dir": str(br_train_dir),
            "main_training_checkpoint": main_train_artifacts.training_checkpoint,
            "br_training_checkpoint": br_train_artifacts.training_checkpoint,
            "working_checkpoint": str(selected_main_checkpoint),
            "deployment_checkpoint": str(deployment_manifest_path),
            "meta_strategy_path": str(deployment_manifest_path),
            "frozen_population": [entry.to_dict() for entry in manager.frozen_entries()],
            "meta_probabilities": dict(meta_snapshot.probabilities),
            "meta_expected_utilities": dict(meta_snapshot.expected_utilities),
            "meta_support_set": list(meta_snapshot.support_set),
            "active_main_slot": main_slot_state.to_dict(),
            "active_br_slot": br_slot_state.to_dict(),
            "active_main_selection_path": str(main_selection_path),
            "active_br_selection_path": str(br_selection_path),
            "active_main_expected_payoff_vs_meta": float(selected_main_candidate.expected_payoff_vs_meta),
            "active_br_expected_payoff_vs_meta": float(selected_br_candidate.expected_payoff_vs_meta),
            "promoted_policy_ids": [entry.policy_id for entry in promoted_entries],
            "baseline_eval_only": True,
            "draw_rate": float(self_play_analysis.draw_rate),
            "late_round_rate": float(self_play_analysis.late_round_rate),
        }
        atomic_write_json(analysis_path, analysis_payload)
        current_training_checkpoint = Path(selected_main_checkpoint)
        _persist_phase_state(
            working_checkpoint=current_training_checkpoint,
            completed_round=round_index,
            current_round=None,
            current_phase=None,
        )
        round_result = PpoManagedRoundResult(
            round_index=round_index,
            bootstrap_path=(str(bootstrap_path) if bootstrap_path.exists() else None),
            self_play_path=str(self_play_path),
            train_artifacts=main_train_artifacts,
            analysis_path=str(analysis_path),
            working_checkpoint=str(current_training_checkpoint),
            deployment_checkpoint=str(deployment_manifest_path),
        )
        round_results = [item for item in round_results if item.round_index != round_index]
        round_results.append(round_result)
        round_results.sort(key=lambda item: item.round_index)
        append_history(
            history_path,
            {
                "event_type": "round_completed",
                "round": round_index,
                "algorithm": "p2sro",
                "working_checkpoint": str(current_training_checkpoint),
                "deployment_checkpoint": str(deployment_manifest_path),
                "active_main_expected_payoff_vs_meta": float(selected_main_candidate.expected_payoff_vs_meta),
                "active_br_expected_payoff_vs_meta": float(selected_br_candidate.expected_payoff_vs_meta),
                "frozen_population_members": [entry.policy_id for entry in manager.frozen_entries()],
                "meta_probabilities": dict(meta_snapshot.probabilities),
                "active_main_slot_lineage": main_slot_state.lineage,
                "active_br_slot_lineage": br_slot_state.lineage,
                "promoted_policy_ids": [entry.policy_id for entry in promoted_entries],
                "draw_rate": float(self_play_analysis.draw_rate),
                "late_round_rate": float(self_play_analysis.late_round_rate),
            },
        )
        bootstrap_episodes = ()
        self_play_episodes = ()
        replay_episodes = ()
        br_self_play_episodes = ()
        br_replay_episodes = ()
        gc.collect()
        cleanup_completed_round_training_temps(workspace_path, completed_round=round_index - 1)
        pruned_rounds = prune_old_round_directories(
            workspace_path,
            current_round=round_index,
            retain_round_directories=retain_round_directories,
            protected_paths=(
                current_training_checkpoint,
            ),
        )
        if pruned_rounds:
            round_results = [
                item for item in round_results
                if f"round_{item.round_index:04d}" not in pruned_rounds
            ]

    if current_training_checkpoint is None:
        raise RuntimeError("P2SRO loop finished without a checkpoint")
    if inference_server is not None:
        inference_server.close()
    payload = {
        "workspace": str(workspace_path),
        "working_checkpoint": str(current_training_checkpoint),
        "deployment_checkpoint": str(deployment_manifest_path),
        "status_path": str(status_path),
        "history_path": str(history_path),
        "state_path": str(state_path),
        "p2sro_state_path": str(p2sro_state_path),
        "rounds": [
            {
                "round": item.round_index,
                "bootstrap_path": item.bootstrap_path,
                "self_play_path": item.self_play_path,
                "training_checkpoint": item.train_artifacts.training_checkpoint,
                "deployment_checkpoint": item.deployment_checkpoint,
                "working_checkpoint": item.working_checkpoint,
                "analysis_path": item.analysis_path,
            }
            for item in round_results
        ],
    }
    atomic_write_json(result_path, payload)
    return PpoManagedLoopArtifacts(
        workspace=str(workspace_path),
        rounds=tuple(round_results),
        working_checkpoint=str(current_training_checkpoint),
        deployment_checkpoint=str(deployment_manifest_path),
        status_path=str(status_path),
        history_path=str(history_path),
        state_path=str(state_path),
    )
