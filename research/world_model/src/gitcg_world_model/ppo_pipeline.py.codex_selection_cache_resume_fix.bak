_PHASE_RANKS: dict[str, int] = {
    "bootstrap": 0,
    "active_main_slot": 1,
    "active_br_slot": 2,
    "round_finalize": 3,
}

_BENCHMARK_CACHE_FORMAT = "benchmark_episode_summary_v1"
_BENCHMARK_WORKERS_ENV = "P2SRO_BENCHMARK_WORKERS"
_BENCHMARK_CACHE_FLUSH_ENV = "P2SRO_BENCHMARK_CACHE_FLUSH_THRESHOLD"
_DEFAULT_BENCHMARK_WORKER_CAP = 2
_DEFAULT_BENCHMARK_CACHE_FLUSH = 8
