+_EPISODE_RETRY_LIMIT_ENV = "GITCG_EPISODE_RETRY_LIMIT"
+_EPISODE_RETRY_LIMIT_DEFAULT = 8
+_EPISODE_RETRY_SEED_STRIDE = 1_000_003
+
+
+def _episode_retry_limit() -> int:
+    raw = os.environ.get(_EPISODE_RETRY_LIMIT_ENV)
+    if raw is None:
+        return _EPISODE_RETRY_LIMIT_DEFAULT
+    try:
+        return max(0, int(raw.strip()))
+    except ValueError:
+        return _EPISODE_RETRY_LIMIT_DEFAULT
+
+
+def _all_player_characters_defeated(player: Any) -> bool:
+    characters = tuple(getattr(player, "characters", ()) or ())
+    return bool(characters) and all(bool(getattr(character, "defeated", False)) for character in characters)
+
+
+def _episode_retry_reason(*, episode: EpisodeRecord, config: EnvConfig) -> str | None:
+    metadata = dict(episode.metadata or {})
+    if bool(metadata.get("invalid_terminal")):
+        return str(metadata.get("invalid_terminal_reason") or "invalid_terminal")
+    if bool(metadata.get("truncated")):
+        return str(metadata.get("truncation_reason") or "truncated_episode")
+
+    final_state = episode.final_state
+    phase = str(getattr(final_state, "phase", "") or "")
+    if phase != "game_end":
+        return f"terminal_phase={phase or 'unknown'}"
+
+    players = tuple(getattr(final_state, "players", ()) or ())
+    if len(players) != 2:
+        return None
+
+    player0_all_defeated = _all_player_characters_defeated(players[0])
+    player1_all_defeated = _all_player_characters_defeated(players[1])
+    winner = episode.winner
+
+    if winner == 0:
+        if player1_all_defeated and not player0_all_defeated:
+            return None
+        return "inconsistent_final_winner=0"
+    if winner == 1:
+        if player0_all_defeated and not player1_all_defeated:
+            return None
+        return "inconsistent_final_winner=1"
+
+    final_round = int(getattr(final_state, "round_number", 0) or 0)
+    max_rounds = (
+        int(config.max_rounds)
+        if getattr(config, "max_rounds", None) is not None
+        else None
+    )
+    if player0_all_defeated and player1_all_defeated:
+        return None
+    if max_rounds is not None and final_round >= max_rounds:
+        return None
+    return "invalid_draw_without_dual_ko_or_round_cap"
+
+
+def _benchmark_eval_workers(requested_workers: int) -> int:
+    # Selection / payoff evaluation has been the main source of JS heap OOMs.
+    return 1 if requested_workers > 0 else 1
+
