+def _find_snippets(text: str, token: str, *, radius: int = 140, limit: int = 2) -> list[str]:
+    snippets: list[str] = []
+    start = 0
+    while len(snippets) < limit:
+        index = text.find(token, start)
+        if index < 0:
+            break
+        left = max(0, index - radius)
+        right = min(len(text), index + len(token) + radius)
+        snippets.append(text[left:right].replace("\n", " "))
+        start = index + len(token)
+    return snippets


